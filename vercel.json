{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/search",
      "destination": "/api/search"
    },
    {
      "source": "/site",
      "destination": "/public/site.html"
    },
    {
      "source": "/explore",
      "destination": "/public/explore.html"
    },
    {
      "source": "/terminal",
      "destination": "/public/terminal.html"
    },
    {
      "source": "/dashboard",
      "destination": "/public/dashboard.html"
    },
    {
      "source": "/api/live/:metric",
      "destination": "/public/data/live/:metric.json"
    },
    {
      "source": "/api/market/:metric",
      "destination": "/public/data/market/:metric.json"
    },
    {
      "source": "/api/deal/:metric",
      "destination": "/public/data/deal/:metric.json"
    },
    {
      "source": "/api/stats",
      "destination": "/public/data/stats.json"
    },
    {
      "source": "/api/categories",
      "destination": "/public/data/categories.json"
    },
    {
      "source": "/api/sources",
      "destination": "/public/data/sources.json"
    },
    {
      "source": "/api/health",
      "destination": "/public/data/health.json"
    },
    {
      "source": "/",
      "destination": "/public/index.html"
    }
  ],
  "functions": {
    "api/search.py": {
      "runtime": "@vercel/python",
      "maxDuration": 30
    }
  }
}