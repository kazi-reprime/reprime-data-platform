{
  "version": 2,
  "cleanUrls": true,
  "functions": {
    "api/search.py": {
      "runtime": "@vercel/python",
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/site",
      "destination": "/site.html"
    },
    {
      "source": "/explore",
      "destination": "/explore.html"
    },
    {
      "source": "/terminal",
      "destination": "/terminal.html"
    },
    {
      "source": "/dashboard",
      "destination": "/dashboard.html"
    },
    {
      "source": "/api/live/:path*",
      "destination": "/data/live/:path*.json"
    },
    {
      "source": "/api/market/:path*",
      "destination": "/data/market/:path*.json"
    },
    {
      "source": "/api/deal/:path*",
      "destination": "/data/deal/:path*.json"
    },
    {
      "source": "/api/stats",
      "destination": "/data/stats.json"
    },
    {
      "source": "/api/categories",
      "destination": "/data/categories.json"
    },
    {
      "source": "/api/sources",
      "destination": "/data/sources.json"
    },
    {
      "source": "/api/health",
      "destination": "/data/health.json"
    },
    {
      "source": "/images/:path*",
      "destination": "/public/images/:path*"
    }
  ]
}