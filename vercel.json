{
  "version": 2,
  "outputDirectory": "public",
  "functions": {
    "api/search.py": {
      "maxDuration": 30
    },
    "api/health.py": {
      "maxDuration": 10
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "X-Content-Type-Options",   "value": "nosniff" },
        { "key": "X-Frame-Options",          "value": "DENY" },
        { "key": "Referrer-Policy",          "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy",       "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()" },
        { "key": "Content-Security-Policy",  "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com https://unpkg.com; style-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com https://unpkg.com https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; connect-src 'self' https://gugcmsqrscqqqltdtgkz.supabase.co https://*.supabase.co https://api.census.gov https://geocoding.geo.census.gov https://api.stlouisfed.org https://api.coingecko.com https://api.frankfurter.app https://www.federalregister.gov https://banks.data.fdic.gov https://www.fema.gov https://www.opendata.fema.gov https://overpass-api.de https://api.weather.gov https://earthquake.usgs.gov https://api.openchargemap.io https://nominatim.openstreetmap.org https://photon.komoot.io https://api.open-meteo.com https://air-quality-api.open-meteo.com https://geo.fcc.gov https://en.wikipedia.org https://api.gdeltproject.org https://graph.mapillary.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" }
      ]
    },
    {
      "source": "/data/(.*)\\.json",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=300, s-maxage=600, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=2592000, immutable" }
      ]
    },
    {
      "source": "/(rp-shell\\.css|.+\\.js)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=300, stale-while-revalidate=86400" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/site",
      "destination": "/site.html"
    },
    {
      "source": "/explore",
      "destination": "/explore.html"
    },
    {
      "source": "/terminal",
      "destination": "/terminal.html"
    },
    {
      "source": "/dashboard",
      "destination": "/dashboard.html"
    },
    {
      "source": "/data",
      "destination": "/data-coverage.html"
    },
    {
      "source": "/wall",
      "destination": "/wall.html"
    },
    {
      "source": "/sources",
      "destination": "/sources.html"
    },
    {
      "source": "/about",
      "destination": "/about.html"
    },
    {
      "source": "/team",
      "destination": "/team.html"
    },
    {
      "source": "/partners",
      "destination": "/partners.html"
    },
    {
      "source": "/faq",
      "destination": "/faq.html"
    },
    {
      "source": "/help",
      "destination": "/help.html"
    },
    {
      "source": "/api/live/:metric",
      "destination": "/data/live/:metric.json"
    },
    {
      "source": "/api/market/:metric",
      "destination": "/data/market/:metric.json"
    },
    {
      "source": "/api/deal/:metric",
      "destination": "/data/deal/:metric.json"
    },
    {
      "source": "/api/stats",
      "destination": "/data/stats.json"
    },
    {
      "source": "/api/categories",
      "destination": "/data/categories.json"
    },
    {
      "source": "/api/sources",
      "destination": "/data/sources.json"
    }
  ]
}