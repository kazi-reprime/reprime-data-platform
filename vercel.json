{
  "version": 2,
  "outputDirectory": "public",
  "functions": {
    "api/property.py": {
      "maxDuration": 30,
      "memory": 256
    }
  },
  "rewrites": [
    { "source": "/site", "destination": "/site.html" },
    { "source": "/explore", "destination": "/explore.html" },
    { "source": "/terminal", "destination": "/terminal.html" },
    { "source": "/dashboard", "destination": "/dashboard.html" },
    { "source": "/api/live/:metric", "destination": "/data/live/:metric.json" },
    { "source": "/api/market/:metric", "destination": "/data/market/:metric.json" },
    { "source": "/api/deal/:metric", "destination": "/data/deal/:metric.json" },
    { "source": "/api/stats", "destination": "/data/stats.json" },
    { "source": "/api/categories", "destination": "/data/categories.json" },
    { "source": "/api/sources", "destination": "/data/sources.json" },
    { "source": "/api/health", "destination": "/data/health.json" }
  ],
  "headers": [
    { "source": "/data/(.*)", "headers": [
      { "key": "Content-Type", "value": "application/json" },
      { "key": "Access-Control-Allow-Origin", "value": "*" }
    ]}
  ]
}
