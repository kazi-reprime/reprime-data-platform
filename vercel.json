{
  "version": 2,
  "builds": [
    {
      "src": "api/search.py",
      "use": "@vercel/python"
    },
    {
      "src": "*.html",
      "use": "@vercel/static"
    },
    {
      "src": "data/**",
      "use": "@vercel/static"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/search(.*)",
      "dest": "/api/search.py$1"
    },
    {
      "src": "/site",
      "dest": "/site.html"
    },
    {
      "src": "/explore",
      "dest": "/explore.html"
    },
    {
      "src": "/terminal",
      "dest": "/terminal.html"
    },
    {
      "src": "/dashboard",
      "dest": "/dashboard.html"
    },
    {
      "src": "/api/live/(.*)",
      "dest": "/data/live/$1.json"
    },
    {
      "src": "/api/market/(.*)",
      "dest": "/data/market/$1.json"
    },
    {
      "src": "/api/deal/(.*)",
      "dest": "/data/deal/$1.json"
    },
    {
      "src": "/api/stats",
      "dest": "/data/stats.json"
    },
    {
      "src": "/api/sources",
      "dest": "/data/sources.json"
    },
    {
      "src": "/images/(.*)",
      "dest": "/public/images/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}